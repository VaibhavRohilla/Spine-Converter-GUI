recursive-include tests/fixtures *
recursive-include docs *.md *.json
include scripts/verify_binary_reference.mjs
include package.json package-lock.json eslint.config.mjs DESIGN.md
recursive-include viewer *.md *.ts *.mjs *.py *.html *.css *.json *.template *.png *.atlas *.skel LICENSE
prune viewer/node_modules
prune viewer/dist
prune viewer/.runtime
prune viewer/test-results
prune viewer/viewer
prune viewer/src/generated
recursive-include docs/licenses *.txt
recursive-include docs/evidence/B4/candidate-references *.png
